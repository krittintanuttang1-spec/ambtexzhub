-- LOGIC & GAME SYSTEMS (Aimbot, ESP, Fly, Noclip)
--==================================================

local flying = false
local flySpeed = 50
local speedVal = 16
local bodyGyro, bodyVelocity
local noclipConnection = false

local aimbotEnabled = false
local fovToggle = true
local fovSize = 100
local lockedTarget = nil

local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible = false
FOVCircle.Filled = false
FOVCircle.Thickness = 3
FOVCircle.Transparency = 1

local espEnabled = false
local tracersEnabled = false
local tracersPool = {}

-- ฟังก์ชันบิน
local function startFly()
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	local hrp = character.HumanoidRootPart
	
	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.P = 9e4
	bodyGyro.maxTorque = Vector3.new(9e4, 9e4, 9e4)
	bodyGyro.cframe = hrp.CFrame
	bodyGyro.Parent = hrp

	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.velocity = Vector3.new(0, 0, 0)
	bodyVelocity.maxForce = Vector3.new(9e4, 9e4, 9e4)
	bodyVelocity.Parent = hrp

	flying = true
	
	task.spawn(function()
		while flying and character and character:FindFirstChild("Humanoid") do
			RunService.RenderStepped:Wait()
			local moveDir = character.Humanoid.MoveDirection
			if moveDir.Magnitude > 0 then
				bodyVelocity.velocity = Camera.CFrame.LookVector * flySpeed * 2
			else
				bodyVelocity.velocity = Vector3.new(0, 0, 0)
			end
			bodyGyro.cframe = Camera.CFrame
		end
	end)
end

local function stopFly()
	flying = false
	if bodyGyro then bodyGyro:Destroy() end
	if bodyVelocity then bodyVelocity:Destroy() end
end

-- ฟังก์ชัน Noclip
local function toggleNoclip(state)
	noclipConnection = state
	if noclipConnection then
		RunService.Stepped:Connect(function()
			if noclipConnection and player.Character then
				for _, part in ipairs(player.Character:GetDescendants()) do
					if part:IsA("BasePart") and part.CanCollide then
						part.CanCollide = false
					end
				end
			end
		end)
	end
end

-- ระบบ Aimbot ค้นหาเป้าหมาย
local function getClosestPlayerToCursor()
	if lockedTarget and lockedTarget.Parent and lockedTarget.Parent:FindFirstChild("Humanoid") then
		if lockedTarget.Parent.Humanoid.Health > 0 then
			local screenPoint, onScreen = Camera:WorldToScreenPoint(lockedTarget.Position)
			if onScreen then
				local mousePos = UserInputService:GetMouseLocation()
				local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
				if dist < (fovSize * 2.5) then
					return lockedTarget
				end
			end
		end
	end

	local target = nil
	local shortestDist = fovSize

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local isSameTeam = (player.Team and p.Team and player.Team == p.Team)
			if not isSameTeam and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") then
				if p.Character.Humanoid.Health > 0 then
					local head = p.Character.Head
					local screenPoint, onScreen = Camera:WorldToScreenPoint(head.Position)
					if onScreen then
						local mousePos = UserInputService:GetMouseLocation()
						local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
						if dist < shortestDist then
							shortestDist = dist
							target = head
						end
					end
				end
			end
		end
	end
	
	lockedTarget = target
	return target
end

-- Setup Highlight ESP
local function setupHighlight(p)
	if p == player then return end
	local function apply(char)
		if not char or char:FindFirstChild("EXZ_Highlight") then return end
		local h = Instance.new("Highlight")
		h.Name = "EXZ_Highlight"
		h.Adornee = char
		h.Parent = char
		h.Enabled = espEnabled
		h.FillTransparency = 0.5
		h.OutlineTransparency = 0
	end
	p.CharacterAdded:Connect(apply)
	if p.Character then task.spawn(function() apply(p.Character) end) end
end
for _, p in ipairs(Players:GetPlayers()) do setupHighlight(p) end
Players.PlayerAdded:Connect(setupHighlight)

local function getLine()
	local line = Drawing.new("Line")
	line.Thickness = 1.5
	line.Transparency = 1
	line.Visible = false
	return line
end

-- RenderStepped ลูปหลักของระบบ
RunService.RenderStepped:Connect(function()
	-- อัปเดตวงกลม FOV สีรุ้ง
	local viewportSize = Camera.ViewportSize
	FOVCircle.Position = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
	FOVCircle.Radius = fovSize
	FOVCircle.Visible = aimbotEnabled and fovToggle
	FOVCircle.Color = Color3.fromHSV(tick() % 5 / 5, 1, 1)

	-- Aimbot ทำงาน
	if aimbotEnabled then
		local targetHead = getClosestPlayerToCursor()
		if targetHead then
			local targetCFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
			Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.3)
		else
			lockedTarget = nil
		end
	else
		lockedTarget = nil
	end

	-- ESP Tracers & Highlights
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			if not tracersPool[p] then tracersPool[p] = getLine() end
			local line = tracersPool[p]
			local char = p.Character
			local isSameTeam = (player.Team and p.Team and player.Team == p.Team)

			if tracersEnabled and char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
				local hrp = char.HumanoidRootPart
				local vector, onScreen = Camera:WorldToScreenPoint(hrp.Position)
				if onScreen then
					line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
					line.To = Vector2.new(vector.X, vector.Y)
					line.Color = isSameTeam and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
					line.Visible = true
				else
					line.Visible = false
				end
			else
				line.Visible = false
			end

			local highlight = char and char:FindFirstChild("EXZ_Highlight")
			if highlight then
				highlight.Enabled = espEnabled
				if espEnabled then
					highlight.FillColor = isSameTeam and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
					highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
				end
			end
		end
	end
end)

